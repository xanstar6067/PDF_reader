<Window x:Class="PDF_Reader.Views.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Печать — PaperDesk PDF" Width="1140" Height="860" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24" TextBox.TextChanged="SettingsChanged" ComboBox.SelectionChanged="SettingsChanged"
          CheckBox.Checked="SettingsChanged" CheckBox.Unchecked="SettingsChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="460"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,18">
            <TextBlock Text="Печать" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock x:Name="DocumentTitle" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Принтер" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <DockPanel>
                    <Button x:Name="PropertiesButton" DockPanel.Dock="Right" Content="Свойства…" Click="PropertiesClick" Height="32" Padding="12,4" Margin="8,0,0,0" IsEnabled="False"/>
                    <ComboBox x:Name="PrinterBox" SelectionChanged="PrinterChanged" MinWidth="180"/>
                </DockPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Бумага" Margin="0,0,0,6"/><ComboBox x:Name="PaperBox"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Ориентация" Margin="0,0,0,6"/>
                        <ComboBox x:Name="OrientationBox" SelectedIndex="0"><ComboBoxItem Content="Автоматически"/><ComboBoxItem Content="Книжная"/><ComboBoxItem Content="Альбомная"/></ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Копии" Margin="0,0,0,6"/><TextBox x:Name="CopiesBox" Text="1" MaxLength="3"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Двусторонняя печать" Margin="0,0,0,6"/><ComboBox x:Name="DuplexBox"/></StackPanel>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                    <CheckBox x:Name="CollateBox" Content="Разобрать по копиям" IsChecked="True" Margin="0,0,16,6"/>
                    <CheckBox x:Name="GrayBox" Content="Оттенки серого" Margin="0,0,0,6"/>
                </WrapPanel>
                <Border Height="1" Background="{DynamicResource Line}" Margin="0,13"/>
                <TextBlock Text="Страницы PDF" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <DockPanel>
                    <ComboBox x:Name="PageSelectionBox" Width="172" DockPanel.Dock="Left" SelectedIndex="0" Margin="0,0,10,0">
                        <ComboBoxItem Content="Все страницы"/><ComboBoxItem Content="Текущая страница"/><ComboBoxItem Content="Указать страницы"/>
                    </ComboBox>
                    <TextBox x:Name="RangeBox" ToolTip="Например: 1, 3-5, 8" IsEnabled="False"/>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <CheckBox x:Name="ReverseBox" DockPanel.Dock="Right" Content="В обратном порядке" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox x:Name="FilterBox" SelectedIndex="0"><ComboBoxItem Content="Все выбранные"/><ComboBoxItem Content="Только нечётные"/><ComboBoxItem Content="Только чётные"/></ComboBox>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Line}" Margin="0,16"/>
                <TextBlock Text="Размещение на бумаге" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TabControl x:Name="ModeTabs" SelectionChanged="ModeChanged" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" Padding="12">
                    <TabItem Header="Размер">
                        <StackPanel>
                            <TextBlock Text="Масштабирование" Margin="0,5,0,7"/>
                            <ComboBox x:Name="ScalingBox" SelectedIndex="0"><ComboBoxItem Content="Вписать в область печати"/><ComboBoxItem Content="Фактический размер (100 %)"/><ComboBoxItem Content="Уменьшать только крупные страницы"/><ComboBoxItem Content="Свой масштаб"/></ComboBox>
                            <DockPanel Margin="0,12,0,0"><TextBlock Text="Масштаб, %" VerticalAlignment="Center"/><TextBox x:Name="ScaleBox" Text="100" Width="80" Margin="14,0,0,0" HorizontalAlignment="Left" IsEnabled="False"/></DockPanel>
                            <TextBlock Text="В фактическом размере и при своём масштабе содержимое за границами области печати обрезается." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,12,0,0" FontSize="12"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Постер">
                        <StackPanel>
                            <TextBlock Text="Большая страница частями на нескольких листах" TextWrapping="Wrap" Margin="0,5,0,12"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Масштаб, %" Margin="0,0,0,6"/><TextBox x:Name="TileScaleBox" Text="100"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Нахлёст рисунка, мм" Margin="0,0,0,6"/><TextBox x:Name="OverlapBox" Text="5"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Поля под склейку, мм" FontWeight="SemiBold" Margin="0,16,0,8"/>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Слева" Margin="0,0,0,6"/><TextBox x:Name="GlueLeftBox" Text="8"/></StackPanel>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Сверху" Margin="0,0,0,6"/><TextBox x:Name="GlueTopBox" Text="8"/></StackPanel>
                                <StackPanel Margin="0,0,6,0"><TextBlock Text="Справа" Margin="0,0,0,6"/><TextBox x:Name="GlueRightBox" Text="8"/></StackPanel>
                                <StackPanel><TextBlock Text="Снизу" Margin="0,0,0,6"/><TextBox x:Name="GlueBottomBox" Text="8"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Белые поля внутри доступной области принтера. Нахлёст повторяет рисунок соседнего листа и задаётся отдельно." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,10"/>
                            <CheckBox x:Name="LabelsBox" Content="Координаты листа на полях: 1-1, 1-2…" IsChecked="True" Margin="0,5"/>
                            <CheckBox x:Name="CutMarksBox" Content="Метки обрезки" IsChecked="True" Margin="0,5"/>
                            <CheckBox x:Name="LargeOnlyBox" Content="Делить только большие страницы" IsChecked="True" Margin="0,5"/>
                            <TextBlock Text="Номер: строка-столбец, от верхнего левого угла. Для подписей сверху и снизу сохраняется минимум 5,3 мм." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Несколько">
                        <StackPanel>
                            <TextBlock Text="Страниц на одном листе" Margin="0,5,0,8"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Столбцы (1–8)" Margin="0,0,0,6"/><TextBox x:Name="ColumnsBox" Text="2" MaxLength="1"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Строки (1–8)" Margin="0,0,0,6"/><TextBox x:Name="RowsBox" Text="2" MaxLength="1"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Порядок страниц" Margin="0,12,0,6"/>
                            <ComboBox x:Name="OrderBox" SelectedIndex="0"><ComboBoxItem Content="По строкам, слева направо"/><ComboBoxItem Content="По столбцам, сверху вниз"/><ComboBoxItem Content="По строкам, справа налево"/><ComboBoxItem Content="По столбцам, справа налево"/></ComboBox>
                            <CheckBox x:Name="BorderBox" Content="Рамка вокруг каждой страницы" Margin="0,14,0,0"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Брошюра">
                        <StackPanel>
                            <TextBlock Text="Две страницы на стороне, в порядке для сгиба и скрепления. Пустые страницы добавляются автоматически." TextWrapping="Wrap" Margin="0,5,0,12"/>
                            <TextBlock Text="Стороны листов" Margin="0,0,0,6"/>
                            <ComboBox x:Name="BookletSideBox" SelectedIndex="0"><ComboBoxItem Content="Обе стороны (нужен дуплекс)"/><ComboBoxItem Content="Только лицевые"/><ComboBoxItem Content="Только оборотные"/></ComboBox>
                            <CheckBox x:Name="RightBindingBox" Content="Переплёт справа" Margin="0,14,0,0"/>
                            <TextBlock Text="При ручной печати сначала напечатайте лицевые стороны, затем переверните стопку и напечатайте оборотные. Способ переворота зависит от подачи вашего принтера." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,14,0,0"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
                <CheckBox x:Name="AutoRotateBox" Content="Автоповорот страниц для лучшего размещения" IsChecked="True" Margin="0,14,0,12"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource Workspace}" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12"><TextBlock Text="Предпросмотр листа" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="PaperSummary" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
                <Image x:Name="PreviewImage" Grid.Row="1" Stretch="Uniform" Margin="12"/>
                <TextBlock x:Name="PreviewBusy" Grid.Row="1" Text="Подготовка предпросмотра…" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <DockPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button x:Name="PreviousButton" Content="‹" Click="PreviousClick" DockPanel.Dock="Left" Width="40" IsEnabled="False" ToolTip="Предыдущий лист"/>
                    <Button x:Name="NextButton" Content="›" Click="NextClick" DockPanel.Dock="Right" Width="40" IsEnabled="False" ToolTip="Следующий лист"/>
                    <StackPanel><TextBlock x:Name="SheetCounter" TextAlignment="Center" FontWeight="SemiBold"/><TextBlock x:Name="SheetLabel" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="6,4"/></StackPanel>
                </DockPanel>
                <WrapPanel x:Name="TileMap" Grid.Row="3" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Grid.Row="4" Text="Пунктир — границы печати и изображения; на бумаге его не будет." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,12,0,0"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Загрузка принтеров…" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource Muted}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Отмена" IsCancel="True" MinWidth="100" Margin="0,0,10,0"/><Button x:Name="PrintButton" Content="Печать" IsDefault="True" MinWidth="110" IsEnabled="False" Style="{StaticResource AccentButton}" Click="PrintClick"/></StackPanel>
        </Grid>
    </Grid>
</Window>
