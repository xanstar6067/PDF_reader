<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PaperDesk</AssemblyName>
    <Product>PaperDesk PDF</Product>
    <Version>1.0.0</Version>
    <Description>Просмотр и редактирование PDF документов</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/paperdesk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/paperdesk.ico" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8086" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <InternalsVisibleTo Include="PDF_Reader.Tests" />
    <Content Include="../../third-party/**/*" Link="third-party/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildPaperDesk3D" BeforeTargets="BeforeBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)/../../tools/Build-3D.ps1&quot;" />
  </Target>
  <ItemGroup>
    <Content Include="../../artifacts/native3d/bin/Release/PaperDesk3D.dll" Link="PaperDesk3D.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../artifacts/native3d/bin/Release/PaperDeskModelWorker.exe" Link="PaperDeskModelWorker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
